# Copy to .env and fill in values

DATABASE_URL=sqlite+aiosqlite:///./data/sofia.db
SUPER_ADMIN_EMAIL=admin@example.com

# Generate: python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key.decode()); print(v.public_key.decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Random 32+ char string
SECRET_KEY=change-me-to-a-random-secret-key

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Dev mode: skip Cloudflare header, use fixed email
# DEV_EMAIL=dev@example.com

# Get a key at https://aistudio.google.com/apikey — used to read the weekly
# meal-plan photo (Essensplan) into a day-by-day table. Leave empty to
# disable the feature (upload still works, just without auto-recognition).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Shown in the app's Impressum & Datenschutz dialog (§5 TMG). Set these
# per-deployment in .env — never commit real contact details here.
IMPRESSUM_BUSINESS_NAME=Sofia Schulbegleiter PWA
IMPRESSUM_NAME=Max Mustermann
IMPRESSUM_ADDRESS=Musterstraße 123<br>12345 Musterstadt
IMPRESSUM_PHONE=+49 (0) 123 456789
IMPRESSUM_EMAIL=support@sofia.schule
